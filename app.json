{
  "expo": {
    "name": "Prados de la Huerta",
    "slug": "ComPayMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    // Primary app icon used for the home screen (includes branding text)
    "icon": "./assets/images/pradoshuertaicon.png",
    "scheme": "compaymobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mendozadev.pradoslahuerta",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      // Simplified icon for browser tabs to ensure visibility at small scales
      "favicon": "./assets/images/pradoshuertafavicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          // Option A: Using the simplified tree icon (pradoshuertafavicon.png) as splash icon
          "image": "./assets/images/pradoshuertafavicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          // Background color set to match the icon's yellow brand color for a seamless look
          "backgroundColor": "#F9E11E",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33e20a6d-8a7b-4fdc-808c-bfba564b1c18"
      }
    }
  }
}