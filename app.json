{
  "expo": {
    "name": "Prados de la Huerta",
    "slug": "ComPayMobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/pradoshuertaicon.png",
    "scheme": "compaymobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/33e20a6d-8a7b-4fdc-808c-bfba564b1c18"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mendozadev.pradoslahuerta",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/pradoshuertafavicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/pradoshuertafavicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9E11E",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33e20a6d-8a7b-4fdc-808c-bfba564b1c18"
      }
    }
  }
}
